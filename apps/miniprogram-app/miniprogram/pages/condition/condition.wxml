<!-- 病程详情 -->
<view class="page {{big ? 'big-mode' : ''}}">

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
    <view class="btn btn-primary btn-block" bindtap="retry">重试</view>
  </block>

  <block wx:elif="{{condition}}">
    <!-- 病程头 -->
    <view class="cond-head">
      <view class="cond-title">
        {{condition.title}}
        <text wx:if="{{condition.is_ongoing}}" class="ongoing-tag">进行中</text>
        <text wx:else class="tag tag-grey">已结束</text>
      </view>
      <view class="cond-sub">
        {{person.name}} · {{person.gender === 'male' ? '男' : (person.gender === 'female' ? '女' : '—')}} {{person.age}} 岁 · {{person.blood_type}} 型
        <view>{{condition.start_date}} 开始 · {{condition.duration_days}} 天 · {{daily.length}} 条记录</view>
      </view>
    </view>

    <!-- 逐日 -->
    <view class="card">
      <view class="sec-title">
        <view class="h"><view class="bar"></view>逐日记录</view>
        <view class="more">缺记录的天也保留</view>
      </view>

      <view class="day" wx:for="{{daily}}" wx:key="date" wx:for-item="row" wx:for-index="i">
        <view class="day-rail">
          <view class="dot {{row.empty ? 'empty' : (row.isAlert ? 'alert' : '')}}"></view>
          <view class="line"></view>
        </view>
        <view class="day-body">
          <view class="day-date">
            {{row.label}}
            <text wx:if="{{row.isBackfilled}}" class="backfill-tag">补记</text>
          </view>
          <view class="day-text {{row.empty ? 'empty-text' : ''}}">
            {{row.text}}
            <text wx:if="{{row.severity}}" class="sev sev-{{row.severity}}">
              {{row.severity === 'severe' ? '重' : (row.severity === 'moderate' ? '中' : '轻')}}
            </text>
          </view>
          <view class="day-ops">
            <text class="op" data-i="{{i}}" bindtap="onEditDay">{{row.empty ? '补充这天' : '编辑'}}</text>
            <text wx:if="{{!row.empty}}" class="op danger" data-i="{{i}}" bindtap="onDeleteDay">删除</text>
          </view>
        </view>
      </view>

      <view class="addline" bindtap="onInsert">＋ 插入一天</view>
    </view>

    <!-- 汇总 -->
    <view class="card">
      <view class="kv">
        <view class="k">本次用药</view>
        <view class="v">{{summary.med_summary}}</view>
      </view>
      <view class="kv">
        <view class="k">是否就诊</view>
        <view class="v">{{summary.visited}}</view>
      </view>
      <view class="kv">
        <view class="k">病程状态</view>
        <view class="v">{{condition.is_ongoing ? '进行中' : '已结束（' + condition.end_date + '）'}}</view>
      </view>
    </view>

    <view class="bottom-actions">
      <view class="btn btn-plain flex1" bindtap="{{condition.is_ongoing ? 'onEnd' : 'onReopen'}}">
        {{condition.is_ongoing ? '结束病程' : '重新开启'}}
      </view>
      <view class="btn btn-primary sum-btn" bindtap="onSummary">生成医生摘要 →</view>
    </view>
  </block>

  <form-sheet show="{{form.show}}" title="{{form.title}}"
              fields="{{form.fields}}" values="{{form.values}}"
              bind:submit="onFormSubmit" bind:cancel="onFormCancel" />
</view>
