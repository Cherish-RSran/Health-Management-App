<!-- 健康时间线 · 生病/就诊/检查/体检/疫苗 混排 -->
<view class="page {{big ? 'big-mode' : ''}}">

  <!-- 筛选条 -->
  <view class="filters">
    <scroll-view class="frow" scroll-x enable-flex>
      <view class="f {{personId === '' ? 'on' : ''}}" data-id="" bindtap="onPickPerson">全部成员</view>
      <view class="f {{personId === item.id ? 'on' : ''}}"
            wx:for="{{persons}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onPickPerson">{{item.name}}</view>
    </scroll-view>
    <scroll-view class="frow" scroll-x enable-flex>
      <view class="f {{kind === item.key ? 'on' : ''}}"
            wx:for="{{kindTabs}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onPickKind">{{item.label}}</view>
    </scroll-view>
    <view class="searchwrap">
      <view class="search">
        <text class="search-ic">🔍</text>
        <input placeholder="搜索症状、医院、检查项目" value="{{keyword}}"
               confirm-type="search" bindconfirm="onSearch" bindblur="onSearch" />
        <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
      </view>
    </view>
  </view>

  <!-- 内容 -->
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{needFamily}}">
    <view class="empty">还没有家庭，先去「我的」创建</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
    <view class="btn btn-primary btn-block" bindtap="retry">重试</view>
  </block>

  <block wx:else>
    <block wx:if="{{groups.length}}">
      <view wx:for="{{groups}}" wx:key="key" wx:for-item="group">
        <view class="tl-month {{group.key === 'ongoing' ? 'ongoing-label' : ''}}">{{group.label}}</view>
        <view class="tl">
          <view class="ev {{item.is_ongoing ? 'on' : ''}}"
                wx:for="{{group.items}}" wx:key="ref_id" wx:for-item="item"
                data-id="{{item.ref_id}}" data-kind="{{item.kind}}" data-table2="{{item.rtype}}"
                bindtap="onEvent">
            <view class="badge kind-{{item.kind}}">{{item.kind === 'condition' ? '病' : (item.kind === 'visit' ? '诊' : (item.kind === 'exam' ? '检' : (item.kind === 'checkup' ? '查' : (item.kind === 'vaccine' ? '苗' : '征'))))}}</view>
            <view class="body">
              <view class="r1">
                <text class="ev-title">{{item.title}}</text>
                <text wx:if="{{item.is_ongoing}}" class="ongoing-tag">进行中</text>
              </view>
              <view class="r2">{{item.subtitle}} · {{item.occurred_label}}</view>
            </view>
            <view class="arrow">›</view>
          </view>
        </view>
      </block>
    </block>

    <view wx:else class="empty">
      <block wx:if="{{keyword}}">没有匹配「{{keyword}}」的记录</block>
      <block wx:else>该筛选下暂无记录</block>
      <view class="muted">点右下 ＋ 可以补记一条</view>
    </view>

    <view wx:if="{{loadingMore}}" class="loading-more">加载中…</view>
    <view wx:elif="{{groups.length && !hasMore}}" class="loading-more">共 {{total}} 条记录</view>
  </block>

  <!-- 悬浮新增 -->
  <view class="fab" bindtap="onAdd">＋</view>
</view>
