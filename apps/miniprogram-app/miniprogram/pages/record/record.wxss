/* 记录 */

.steps-bar { display: flex; padding: 28rpx 28rpx 8rpx; }
.step-dot {
  flex: 1; height: 6rpx; border-radius: 3rpx; margin-right: 10rpx;
  background: #E4E8ED;
}
.step-dot:last-child { margin-right: 0; }
.step-dot.on { background: var(--brand); }

.tip-line {
  padding: 4rpx 32rpx 8rpx;
  font-size: 23rpx; color: var(--t3); line-height: 1.7;
}

.fld { margin-bottom: 32rpx; }
.fld:last-child { margin-bottom: 8rpx; }
.label { font-size: 25rpx; color: var(--t3); font-weight: 600; margin-bottom: 14rpx; }
.req { color: var(--danger); margin-left: 6rpx; }

.input, .picker {
  width: 100%; border: 1rpx solid #E4E8ED; border-radius: 18rpx;
  padding: 22rpx 24rpx; font-size: 29rpx; background: #fff;
  box-sizing: border-box;
}
.picker.picked { border-color: var(--brand); color: var(--brand-3); font-weight: 600; }
.mt16 { margin-top: 16rpx; }

.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 16rpx 28rpx; margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx; background: #F4F6F8;
  font-size: 27rpx; color: var(--t3);
  border: 2rpx solid transparent;
}
.chip.on { background: var(--brand-2); border-color: var(--brand); color: var(--brand-3); font-weight: 600; }

.hint { font-size: 22rpx; color: var(--t3); margin-top: 12rpx; line-height: 1.6; }

/* 逐日 */
.day-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.day-date {
  font-size: 29rpx; font-weight: 600;
  padding: 6rpx 20rpx; border-radius: 12rpx; background: #F2F5F8;
}
.day-remove { font-size: 23rpx; color: #DC2626; }

.addline {
  text-align: center; padding: 24rpx;
  font-size: 26rpx; color: var(--brand-3); font-weight: 600;
}

.bottom-actions { display: flex; padding: 32rpx 28rpx 60rpx; }
.sum-btn { flex: 1.6; margin-left: 20rpx; }

.detail-title {
  font-size: 40rpx; font-weight: 700;
  padding: 28rpx 32rpx 8rpx;
}

/* 附件 / 报告图片网格 */
.img-grid { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.img-cell {
  width: 160rpx; height: 160rpx; border-radius: 16rpx;
  margin: 0 16rpx 16rpx 0; background: #F2F5F8;
  border: 1rpx solid var(--line);
}

/* 报告要点（人工标注）输入区 */
.note-area {
  width: 100%; min-height: 160rpx;
  border: 1rpx solid #E4E8ED; border-radius: 18rpx;
  padding: 22rpx 24rpx; font-size: 28rpx; background: #fff;
  box-sizing: border-box; margin-top: 18rpx;
}
