/* 家人 */

.tip {
  padding: 20rpx 32rpx 8rpx;
  font-size: 23rpx; color: var(--t3); line-height: 1.7;
}
.tip-em { color: #B45309; }

.notice { background: #FFFBEB; }

.pcard {
  display: flex; align-items: center;
  background: var(--card); border-radius: 24rpx;
  margin: 20rpx 28rpx; padding: 26rpx;
}
.pcard-avatar {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; font-weight: 600;
  margin-right: 24rpx; overflow: hidden;
  padding: 0 8rpx; box-sizing: border-box;
}
.pcard-avatar.self { background: var(--brand); }
.pcard-avatar.managed { background: #3B82F6; }
.pcard-body { flex: 1; min-width: 0; }
.pcard-name { font-size: 31rpx; font-weight: 600; }
.pcard-name .tag { margin-left: 12rpx; }
.pcard-sub { font-size: 24rpx; color: var(--t3); margin-top: 8rpx; }
.pcard .arrow { color: #CBD2DA; font-size: 32rpx; margin-left: 12rpx; }

.footer-note {
  text-align: center; font-size: 21rpx; color: #C3CAD3;
  padding: 36rpx 52rpx 20rpx; line-height: 1.8;
}
