<!-- 首页 · 今天该做什么的仪表盘 -->
<view class="page {{big ? 'big-mode' : ''}}">

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{dashboard.needs_family && dashboard.join_status === 'pending'}}">
    <view class="empty">
      <view class="ic">⏳</view>
      <view>申请已提交</view>
      <view class="muted">正在等待「{{dashboard.pending_family_name}}」的管理员同意</view>
    </view>
    <view class="btn btn-ghost btn-block" bindtap="retry">刷新看看</view>
  </block>

  <block wx:elif="{{needFamily}}">
    <view class="empty">
      <view class="ic">🏠</view>
      <view>还没有家庭</view>
      <view class="muted">先创建一个家庭，再把家人加进来</view>
    </view>
    <view class="btn btn-primary btn-block" bindtap="goCreateFamily">去创建家庭</view>
    <view class="btn btn-ghost btn-block mt16" bindtap="goCreateFamily">用邀请码加入</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">{{error}}</view>
    <view class="btn btn-primary btn-block" bindtap="retry">重试</view>
  </block>

  <block wx:else>
    <!-- 家庭横幅 -->
    <view class="hero">
      <view>
        <view class="fam">{{dashboard.family.name}}</view>
        <view class="sub">
          {{dashboard.persons.length}} 位成员<block wx:if="{{dashboard.family.invite_code}}"> · 邀请码 {{dashboard.family.invite_code}}</block>
        </view>
      </view>
      <view class="hero-actions">
        <view class="big-toggle {{big ? 'on' : ''}}" bindtap="onToggleBigHome">{{big ? '大字 开' : '大字 关'}}</view>
        <view class="invite" bindtap="onInvite">＋ 邀请</view>
      </view>
    </view>

    <!-- 成员横条 -->
    <scroll-view class="avatars" scroll-x enable-flex>
      <view class="av" wx:for="{{dashboard.persons}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onPerson">
        <view class="b" style="background:{{item.profile_type === 'self' ? '#0E9F6E' : '#3B82F6'}}">
          {{item.name}}
        </view>
        <view class="n">{{item.relation || '成员'}}</view>
      </view>
      <view wx:if="{{!dashboard.persons.length}}" class="av-empty">还没有档案，去「我的」添加</view>
    </scroll-view>

    <!-- 待审批提醒（仅管理员） -->
    <view wx:if="{{dashboard.pending_count > 0}}" class="card card-flat notice" bindtap="onInvite">
      <view class="row">
        <view class="ic" style="background:#FEF3C7;color:#B45309">待</view>
        <view class="tx">
          <view class="t1">有 {{dashboard.pending_count}} 位成员待审批</view>
          <view class="t2">去「我的 → 家庭管理」处理</view>
        </view>
        <view class="go">›</view>
      </view>
    </view>

    <!-- 卡片区（顺序由用户设置决定；长按进入排序模式） -->
    <block wx:for="{{order}}" wx:key="*this" wx:for-item="cardKey">
      <view class="card-wrap">

        <!-- 排序模式手柄 -->
        <view wx:if="{{sortMode}}" class="sort-bar">
          <text class="sort-label">{{cardLabel[cardKey]}}</text>
          <view class="sort-btns">
            <view class="sort-btn" data-key="{{cardKey}}" data-dir="-1" bindtap="onMove">↑</view>
            <view class="sort-btn" data-key="{{cardKey}}" data-dir="1" bindtap="onMove">↓</view>
          </view>
        </view>

        <!-- === 今天要吃的药 === -->
        <view wx:elif="{{cardKey === 'meds'}}" class="card" bindlongpress="onCardLongPress">
          <view class="sec-title">
            <view class="h"><view class="bar"></view>今天要吃的药</view>
            <view class="more">看一眼就行</view>
          </view>
          <block wx:if="{{dashboard.medicines.length}}">
            <block wx:for="{{dashboard.medicines}}" wx:key="index" wx:for-item="m">
              <view class="med-person">
                <view class="ph">
                  <text class="bold">{{m.person.name}}</text>
                  <text class="muted">{{m.person.age}} 岁 · {{m.person.relation}}</text>
                </view>
                <view class="slot" wx:for="{{m.groups}}" wx:key="slot" wx:for-item="g">
                  <view class="slot-tag {{g.label === nowSlot ? 'slot-now' : ''}}">{{g.label}}</view>
                  <view class="pills">
                    <view class="pill {{taken[it.id] ? 'taken' : ''}}"
                          wx:for="{{g.items}}" wx:key="id" wx:for-item="it"
                          data-id="{{it.id}}" catchtap="onToggleMed">
                      <text class="pill-check" wx:if="{{taken[it.id]}}">✓</text>
                      <text>{{it.name}}</text>
                      <text class="pill-spec">{{it.spec}}</text>
                      <text wx:if="{{it.is_short_term}}" class="tag tag-short">短期</text>
                      <text wx:if="{{it.refill_hint}}" class="pill-hint">{{it.refill_hint}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </block>
          <view wx:else class="muted">暂无在服用的药</view>
          <view class="addline" bindtap="onGoingAddMed">＋ 添加用药</view>
        </view>

        <!-- === 今日待办 === -->
        <view wx:elif="{{cardKey === 'todos'}}" class="card" bindlongpress="onCardLongPress">
          <view class="sec-title">
            <view class="h"><view class="bar"></view>今日待办</view>
            <view class="more">{{dashboard.todos.length}} 项</view>
          </view>
          <block wx:if="{{dashboard.todos.length}}">
            <view class="todo" wx:for="{{dashboard.todos}}" wx:key="id"
                  bindlongpress="onTodoLongPress"
                  data-id="{{item.id}}" data-title="{{item.title}}">
              <view class="dot urgency-{{item.urgency}}"></view>
              <view class="tx">
                <view class="t1 {{item.is_done ? 'done' : ''}}">{{item.title}}</view>
                <view class="t2">{{item.person_name}} · {{item.urgency_text}}</view>
              </view>
              <view class="todo-act {{item.is_done ? 'on' : ''}}"
                    data-id="{{item.id}}" catchtap="onToggleTodo">{{item.is_done ? '✓' : ''}}</view>
            </view>
          </block>
          <view wx:else class="muted">暂无待办</view>
          <view class="addline" bindtap="onQuick">＋ 添加待办</view>
        </view>

        <!-- === 紧急信息卡 === -->
        <view wx:elif="{{cardKey === 'emg'}}" class="card emg-row"
              bindlongpress="onCardLongPress" bindtap="onEmergency">
          <view class="ic emg-ic">急</view>
          <view class="tx">
            <view class="t1">紧急信息卡</view>
            <view class="t2">血型 · 过敏 · 用药 · 联系人</view>
          </view>
          <view class="go">›</view>
        </view>

        <!-- === 快捷操作 === -->
        <view wx:elif="{{cardKey === 'quick'}}" class="card" bindlongpress="onCardLongPress">
          <view class="sec-title"><view class="h"><view class="bar"></view>快捷操作</view></view>
          <view class="quick-grid">
            <view class="quick-item" bindtap="goRecord">＋ 补记病程</view>
            <view class="quick-item" bindtap="onTimeline">健康时间线</view>
          </view>
        </view>

      </view>
    </block>

    <view wx:if="{{sortMode}}" class="btn btn-primary btn-block sort-save" bindtap="onSaveOrder">完成排序</view>
    <view wx:else class="sort-hint">长按卡片可调整顺序</view>

    <view class="footer-note">
      本产品为家庭健康信息记录工具，不提供问诊、诊断、用药建议
    </view>
  </block>
</view>
