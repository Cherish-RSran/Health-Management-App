{
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/",
  "compileType": "miniprogram",
  "libVersion": "3.5.5",
  "appid": "",
  "projectname": "family-health-record",
  "description": "家庭健康档案小程序 · 记录家人档案与病程，就诊时给医生看提炼摘要",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "newFeature": true,
    "coverView": true,
    "nodeModules": false,
    "autoAudits": false,
    "showShadowRootInWxmlPanel": true,
    "scopeDataCheck": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "uploadWithSourceMap": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {
    "miniprogram": {
      "list": []
    }
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "scripts"
      },
      {
        "type": "folder",
        "value": "demo"
      },
      {
        "type": "file",
        "value": "deploy.config.json"
      }
    ]
  }
}
